@page
@model Assignment_6.Pages.AddMovieModel

@{
    ViewData["Title"] = "Add Movie";
}

<h1>Add a Movie</h1>

<form method="post" class="mt-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="NewMovie.Title" class="form-label"></label>
        <input asp-for="NewMovie.Title" class="form-control" />
        <span asp-validation-for="NewMovie.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NewMovie.CategoryId" class="form-label"></label>
        <select asp-for="NewMovie.CategoryId" asp-items="Model.CategoryOptions" class="form-select">
            <option value="">Select a category</option>
        </select>
        <span asp-validation-for="NewMovie.CategoryId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NewMovie.Year" class="form-label"></label>
        <input asp-for="NewMovie.Year" class="form-control" type="number" min="1888" />
        <span asp-validation-for="NewMovie.Year" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NewMovie.Director" class="form-label"></label>
        <input asp-for="NewMovie.Director" class="form-control" />
        <span asp-validation-for="NewMovie.Director" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NewMovie.Rating" class="form-label"></label>
        <select asp-for="NewMovie.Rating" asp-items="Model.RatingOptions" class="form-select">
            <option value="">Select a rating</option>
        </select>
        <span asp-validation-for="NewMovie.Rating" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Edited</label>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="NewMovie.Edited" value="true" id="EditedYes" />
            <label class="form-check-label" for="EditedYes">Yes</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="NewMovie.Edited" value="false" id="EditedNo" />
            <label class="form-check-label" for="EditedNo">No</label>
        </div>
        <span asp-validation-for="NewMovie.Edited" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Copied To Plex</label>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="NewMovie.CopiedToPlex" value="true" id="CopiedToPlexYes" />
            <label class="form-check-label" for="CopiedToPlexYes">Yes</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="NewMovie.CopiedToPlex" value="false" id="CopiedToPlexNo" />
            <label class="form-check-label" for="CopiedToPlexNo">No</label>
        </div>
        <span asp-validation-for="NewMovie.CopiedToPlex" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NewMovie.LentTo" class="form-label"></label>
        <input asp-for="NewMovie.LentTo" class="form-control" />
        <span asp-validation-for="NewMovie.LentTo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NewMovie.Notes" class="form-label"></label>
        <input asp-for="NewMovie.Notes" class="form-control" maxlength="25" />
        <span asp-validation-for="NewMovie.Notes" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Add Movie</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
