@{
    ViewData["Title"] = "Tutoring Calculator";
}

<div class="text-center mb-4">
    <h1 class="display-5">Trailside Tutoring Calculator</h1>
    <p class="lead">Estimate the cost for a one-on-one photo walk.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="hoursInput">Hours needed</label>
                    <input class="form-control" id="hoursInput" type="number" min="1" step="0.5" placeholder="Enter hours" />
                    <div class="form-text text-danger" id="hoursValidation" role="alert"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="rateInput">Rate per hour</label>
                    <input class="form-control" id="rateInput" type="text" value="85" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="totalOutput">Total cost</label>
                    <input class="form-control" id="totalOutput" type="text" readonly />
                </div>
                <button class="btn btn-primary w-100" id="calculateButton" type="button">Calculate total</button>
                <div class="mt-3 text-center">
                    <a asp-controller="Home" asp-action="Index">Back to home</a>
                </div>
            </div>
        </div>
    </div>
</div>
